[Unit]
Description=Backup Stalwart Mail Server
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/stalwart-backup
ExecStart=/usr/local/sbin/backup-stalwart.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/stalwart /var/backups/stalwart /run/lock

[Install]
WantedBy=multi-user.target
