SERVER_PORT=8080
APP_TIME_ZONE=Asia/Shanghai
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
PROMETHEUS_SCRAPE_TOKEN=

DB_ROOT_PASSWORD=
DB_NAME=yxoct_mail
DB_URL=jdbc:mysql://localhost:3306/yxoct_mail?connectionTimeZone=Asia/Shanghai&forceConnectionTimeZoneToSession=true
DB_USERNAME=yxoct_mail
DB_PASSWORD=
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10
DB_POOL_CONNECTION_TIMEOUT=5000
DB_POOL_VALIDATION_TIMEOUT=3000

REDIS_HOST=localhost
REDIS_PORT=6379
# Required by both Spring Boot and the Docker Redis service.
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

MAIL_DOMAIN=yxoct.com
REGISTRATION_INVITATION_TTL=7d
JWT_ISSUER=yxoct-mail-backend
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

STALWART_BASE_URL=https://mail.yxoct.com
STALWART_CONNECT_TIMEOUT=5s
STALWART_READ_TIMEOUT=10s
STALWART_SESSION_CACHE_TTL=1m
STALWART_PROVISIONING_ENABLED=false
STALWART_MANAGEMENT_API_KEY=
STALWART_CREDENTIAL_ENCRYPTION_KEY=
STALWART_PROVISIONING_SCAN_INTERVAL=10s
STALWART_PROVISIONING_LEASE_DURATION=1m
STALWART_PROVISIONING_INITIAL_RETRY_DELAY=30s
STALWART_PROVISIONING_MAX_RETRY_DELAY=1h
STALWART_PROVISIONING_BATCH_SIZE=20
STALWART_RECONCILIATION_SCAN_INTERVAL=5m
STALWART_RECONCILIATION_LEASE_DURATION=10m
STALWART_RECONCILIATION_BATCH_SIZE=20

# Keep this retention slightly longer than Stalwart Data Retention expungeTrashAfter.
MAIL_RESTORE_CLEANUP_ENABLED=true
MAIL_RESTORE_CLEANUP_SCAN_INTERVAL=1d
MAIL_RESTORE_RETENTION=31d
MAIL_RESTORE_CLEANUP_LEASE_DURATION=10m
MAIL_RESTORE_CLEANUP_BATCH_SIZE=500
